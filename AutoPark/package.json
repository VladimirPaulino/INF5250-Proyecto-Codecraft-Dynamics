{
  "name": "autopark_uasd",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "count": "cloc --exclude-dir=node_modules,.git .",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand",
    "db:check": "node database/db_check.js",
    "db:create": "node database/create_database.js",
    "migrate": "knex migrate:latest --knexfile database/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile database/knexfile.js",
    "migrate:status": "knex migrate:list --knexfile database/knexfile.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "knex": "^3.1.0",
    "mariadb": "^3.5.2",
    "mysql2": "^3.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "scc": "^0.1.3",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "classes/**/*.js",
      "routes/**/*.js",
      "!classes/index.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json-summary"
    ],
    "coverageDirectory": "coverage"
  }
}
